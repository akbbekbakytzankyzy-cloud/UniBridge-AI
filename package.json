{
  "name": "unibridge-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:local": "concurrently -k \"npm run local -w apps/api\" \"npm run dev -w apps/web\"",
    "dev": "concurrently -k \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "db:migrate": "npm run migrate -w apps/api",
    "user:create": "npm run user:create -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.10.1"
  }
}
