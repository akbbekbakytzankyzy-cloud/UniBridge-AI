DATABASE_URL=postgres://unibridge:local-development-only@localhost:5432/unibridge
POSTGRES_PASSWORD=local-development-only
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Which option the chat preselects (ollama = Local, openrouter = Cloud); users can switch.
AI_PROVIDER=ollama
OPENROUTER_API_KEY=
# Models per role (defaults shown). See docs/OPENROUTER.md.
OPENROUTER_MODEL_ASSISTANT=anthropic/claude-sonnet-5.5
OPENROUTER_MODEL_INTEGRATION=anthropic/claude-opus-5.5
OPENROUTER_MODEL_EXTRACTION=anthropic/claude-haiku-5.5
OLLAMA_MODEL_EXTRACTION=qwen3:4b
OLLAMA_MODEL_AUTOFILL=qwen3:4b
OLLAMA_MODEL_AUTOFILL_FALLBACK=qwen3:1.7b
OLLAMA_MODEL_EMBEDDINGS=bge-m3
# OneDrive import (Microsoft Graph). Register an app in Microsoft Entra; see docs/ONEDRIVE.md.
MS_CLIENT_ID=
MS_TENANT=organizations
# Only for a "Web" platform registration; leave empty for "Mobile and desktop" (PKCE).
MS_CLIENT_SECRET=
# Defaults to <APP_ORIGIN>/api/onedrive-callback.
MS_REDIRECT_URI=
# Encrypts stored Microsoft sign-ins. The local preview creates data/secret.key itself.
UB_SECRET_KEY=
UB_ONEDRIVE_SYNC_MINUTES=15
